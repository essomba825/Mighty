# Copier ce fichier en `backend/.env` puis adapter les valeurs.
# backend/.env est ignore par git : aucune cle n'est jamais commitee.

# --- General ---
DEBUG=true
# SECRET_KEY=  # obligatoire quand DEBUG=false
# ALLOWED_HOSTS=megamighty-sixers.org
FRONTEND_URL=http://localhost:5173

# --- Emails ---
# Developpement : console (les emails s'impriment dans le terminal).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production : SMTP réel.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=...
# EMAIL_HOST_PASSWORD=...   # mot de passe d'application Gmail
# EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Mega Mighty Sixers <noreply@megamighty-sixers.org>

# --- Web Push (VAPID) ---
# Generer la paire de cles UNE fois :
#   venv/Scripts/python -c "from py_vapid import Vapid02; v=Vapid02(); v.generate_keys(); v.save_key('vapid_private.pem')"
# puis calculer la cle publique :
#   venv/Scripts/python -c "import base64; from py_vapid import Vapid02; from cryptography.hazmat.primitives import serialization; v=Vapid02.from_file('vapid_private.pem'); print(base64.urlsafe_b64encode(v.public_key.public_bytes(serialization.Encoding.X962, serialization.PublicFormat.UncompressedPoint)).decode().rstrip('='))"
# VAPID_PRIVATE_KEY = chemin vers le fichier PEM (ex: /chemin/absolu/vapid_private.pem)
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CONTACT=mailto:contact@votredomaine.org
